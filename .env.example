# Stage 3 market collector defaults.
MARKET_AI_COLLECTOR_ENABLED=true
MARKET_AI_COLLECTOR_POLL_SECONDS=60
MARKET_AI_YFINANCE_TIMEOUT_SECONDS=15

# false = FUTURES:KOSPI200 remains unavailable until a proper futures feed is connected.
# true  = use Yahoo ^KS200 spot index only as an explicit temporary proxy.
MARKET_AI_ALLOW_KOSPI200_INDEX_PROXY=false

# Stage 4 news collector defaults.
MARKET_AI_NEWS_ENABLED=true
MARKET_AI_NEWS_POLL_SECONDS=300
MARKET_AI_NEWS_LOOKBACK_HOURS=3
MARKET_AI_NEWS_MAX_RECORDS_PER_TOPIC=75
MARKET_AI_GDELT_TIMEOUT_SECONDS=20

# Stage 5 AI news analyzer. Optional: disabled by default, no API key is required for Market AI.
MARKET_AI_AI_ENABLED=false
MARKET_AI_AI_POLL_SECONDS=60
MARKET_AI_AI_BATCH_SIZE=10
MARKET_AI_OPENAI_MODEL=gpt-5.6-luna
MARKET_AI_OPENAI_TIMEOUT_SECONDS=45

# Only required when MARKET_AI_AI_ENABLED=true.
# If disabled or blank, AI news is treated as an optional disabled feature, not an error.
# Keep a real key only in local .env. Never commit it.
OPENAI_API_KEY=

# Stage 6 rule-based signal engine. No external API cost.
MARKET_AI_SIGNAL_ENABLED=true
MARKET_AI_SIGNAL_POLL_SECONDS=60
MARKET_AI_SIGNAL_NEWS_LOOKBACK_HOURS=12
MARKET_AI_SIGNAL_MIN_DATA_WEIGHT=0.35


# Stage 8 backtest checkpoint. The evaluator selects the latest stored signal
# before 09:00 KST, but ignores a signal older than this window.
MARKET_AI_BACKTEST_MAX_FORECAST_AGE_HOURS=12

# Stage 9 probability calibration
MARKET_AI_CALIBRATION_MIN_SAMPLES=30
MARKET_AI_CALIBRATION_MIN_CLASS_COUNT=5
MARKET_AI_CALIBRATION_BIN_COUNT=5
MARKET_AI_CALIBRATION_PRIOR_STRENGTH=8

# KIS eFriend Expert local bridge (verified KOSPI200 futures + KOSPI/Samsung/SK hynix realtime feeds).
# Snapshot freshness is updated by every accepted bridge tick, while market_prices history
# is sampled at this interval to avoid storing every exchange tick.
# Optional fixed-code override. Leave blank for automatic KOSPI200 front-month rollover.
# Use only as an emergency/manual override when the exchange calendar requires verification.
MARKET_AI_KIS_KOSPI200_CODE=
MARKET_AI_KIS_HISTORY_INTERVAL_SECONDS=60
MARKET_AI_KIS_HEARTBEAT_STALE_SECONDS=30
# Yahoo remains fallback for KOSPI/Samsung/SK hynix after realtime ticks are stale.
MARKET_AI_KIS_FALLBACK_AFTER_SECONDS=90

# Optional KRX calendar overrides for one-off exchange closures/openings that are
# not yet known to the bundled XKRX/public-holiday calendar. Comma-separated YYYY-MM-DD.
# MARKET_AI_KRX_CLOSED_DATES=
# MARKET_AI_KRX_OPEN_DATES=
# Optional night-session-only closures. The date is the 18:00 session start date.
# Use when regular trading is open but KRX specifically suspends that evening session.
# MARKET_AI_KRX_NIGHT_CLOSED_DATES=
